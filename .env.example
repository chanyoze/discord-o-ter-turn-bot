# 이 파일을 복사해 ".env" 로 저장하고 값을 채우세요. (.env 는 외부 공유 금지!)

# 봇 토큰 (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=여기에_봇_토큰

# 애플리케이션 ID (General Information > Application ID)
CLIENT_ID=여기에_애플리케이션_ID

# 서버 ID (서버 우클릭 > "서버 ID 복사"). 콤마로 여러 서버 가능. 비우면 글로벌.
GUILD_ID=여기에_서버_ID

# (선택) 정원 미달 시 자동 만료 시간(분). 기본 10
# EXPIRE_MINUTES=10
